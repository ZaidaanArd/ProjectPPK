{
  "name": "project-ppk",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:backend": "convex dev",
    "dev:full": "concurrently --kill-others-on-fail \"pnpm dev\" \"pnpm dev:backend\"",
    "build": "next build",
    "start": "next start",
    "lint": "pnpm lint:oxc && pnpm lint:convex",
    "lint:oxc": "oxlint --deny-warnings .",
    "lint:convex": "eslint convex",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "doctor": "react-doctor --no-telemetry --no-supply-chain --yes .",
    "doctor:ci": "react-doctor --no-telemetry --no-supply-chain --yes --blocking error .",
    "peers:check": "pnpm peers check",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm peers:check && pnpm doctor:ci && pnpm build"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@convex-dev/better-auth": "0.12.5",
    "@hugeicons/core-free-icons": "^4.3.0",
    "@hugeicons/react": "^1.1.10",
    "@radix-ui/react-portal": "^1.1.17",
    "@tabler/icons-react": "^3.46.0",
    "better-auth": "~1.6.15",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.2.5",
    "convex": "1.46.0",
    "framer-motion": "^13.4.0",
    "lucide-react": "^1.47.0",
    "motion": "^13.4.0",
    "next": "^16.3.3",
    "onborda": "^1.2.5",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@convex-dev/eslint-plugin": "^5.0.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^9.2.1",
    "convex-test": "^0.0.59",
    "eslint": "^9.39.1",
    "eslint-config-next": "^16.3.3",
    "oxfmt": "0.68.0",
    "oxlint": "1.83.0",
    "react-doctor": "0.9.14",
    "shadcn": "^4.21.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6",
    "vitest": "^4.1.11"
  },
  "packageManager": "pnpm@11.3.0",
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "24.19.0",
      "onFail": "download"
    }
  },
  "engines": {
    "node": ">=20 <25"
  }
}
