{
  "name": "api",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "lint": "eslint .",
    "format": "prettier --write \"**/*.{ts,tsx}\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "tsx src/app/models/seed.ts",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.0",
    "@fastify/cors": "^11.0.0",
    "@fastify/session": "^11.1.0",
    "@workspace/contracts": "workspace:*",
    "drizzle-orm": "^0.44.0",
    "fastify": "^5.6.0",
    "fastify-plugin": "^5.1.0",
    "postgres": "^3.4.7",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10",
    "@types/node": "^24",
    "drizzle-kit": "^0.31.0",
    "eslint": "^10",
    "globals": "^17",
    "pino-pretty": "^13.1.0",
    "tsx": "^4.20.0",
    "typescript": "~6",
    "typescript-eslint": "^8",
    "vitest": "^4.0.0"
  }
}
