# Created by `pnpm convex dev`; never copy a production deployment here.
# dynamic (default) uses Convex; static runs the browser-only development demo.
NEXT_PUBLIC_DATA_MODE=dynamic
CONVEX_DEPLOYMENT=
NEXT_PUBLIC_CONVEX_URL=
NEXT_PUBLIC_CONVEX_SITE_URL=

# Browser-visible URL used by the auth proxy.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Set only to the final HTTPS production domain for SEO metadata.
SITE_URL=
